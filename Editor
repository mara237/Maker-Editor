<style>
:root{
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
  --bg:#F4F3FB;--surface:#FFF;--ink:#17123A;--muted:#5C5780;--line:#DCD9EE;
  --violet:#5B3DF5;--pink:#FF3D7F;--lemon:#FFE45C;--on-violet:#FFF;
  --display:"Bricolage Grotesque","Arial Black",Arial,sans-serif;
  --body:"Figtree",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#120E2B;--surface:#1C1740;--ink:#F1EFFF;--muted:#A9A4D0;--line:#342E63;--violet:#8A74FF;--pink:#FF6B9C;--on-violet:#120E2B}}
:root[data-theme="dark"]{color-scheme:dark;--bg:#120E2B;--surface:#1C1740;--ink:#F1EFFF;--muted:#A9A4D0;--line:#342E63;--violet:#8A74FF;--pink:#FF6B9C;--on-violet:#120E2B}
html{scroll-behavior:smooth;scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);font-size:1.0625rem;line-height:1.75;-webkit-font-smoothing:antialiased}
a{color:inherit}
:focus-visible{outline:3px solid var(--violet);outline-offset:3px;border-radius:4px}
.wrap{max-width:1040px;margin:0 auto;padding:0 1.5rem}
section{padding:6.5rem 0}
h1,h2,h3{font-family:var(--display);margin:0;line-height:1.02;letter-spacing:-.03em}
h2{font-size:clamp(2rem,6vw,3.25rem);font-weight:800;margin-bottom:3rem}
p{margin:0 0 1.25rem;max-width:62ch}
.note{color:var(--muted)}

/* Parte 2 tem um fundo lavanda próprio para parecer outra página */
.part2{--bg:#E9E5FF;--surface:#FFF;--line:#D3CCF5;background:var(--bg);color:var(--ink)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .part2{--bg:#1A1545;--surface:#241E5C;--line:#3A3370}}
:root[data-theme="dark"] .part2{--bg:#1A1545;--surface:#241E5C;--line:#3A3370}

.nav{display:flex;justify-content:space-between;align-items:center;padding-top:1.75rem}
.brand{font-family:var(--display);font-weight:800;font-size:1.25rem;text-decoration:none;letter-spacing:-.04em}
.links{display:flex;gap:1.25rem}
.links a{text-decoration:none;font-weight:600;padding:.5rem 0;border-bottom:3px solid transparent}
.links a:hover{border-color:var(--pink)}

.hero{padding:4.5rem 0 3rem}
.hero h1{font-size:clamp(3.6rem,17vw,9.5rem);font-weight:800;letter-spacing:-.05em}
.role{font-family:var(--display);font-weight:500;font-size:clamp(1.25rem,4vw,1.75rem);letter-spacing:-.02em;margin:1.25rem 0 .5rem}
.lede{color:var(--muted);font-size:1.125rem}
.cta{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.5rem}
.btn{display:inline-flex;align-items:center;min-height:48px;padding:.7rem 1.4rem;border-radius:999px;font-weight:600;text-decoration:none;border:2px solid var(--ink);transition:transform .15s}
.btn:active{transform:scale(.97)}
.btn.main{background:var(--violet);border-color:var(--violet);color:var(--on-violet)}

/* Linha de tempo */
.tl{margin-top:4.5rem;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:.75rem .75rem 1rem;overflow:hidden}
.tl-top{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);padding:0 0 .5rem 2.6rem}
.tl-body{position:relative}
.track{display:flex;align-items:center;height:34px;margin-bottom:6px}
.track>b{width:2.6rem;flex:none;font-size:.78rem;font-weight:600;color:var(--muted)}
.lane{position:relative;flex:1;height:100%;background:repeating-linear-gradient(90deg,transparent 0 calc(10% - 1px),var(--line) calc(10% - 1px) 10%)}
.clip{position:absolute;left:var(--l);width:var(--w);top:3px;bottom:3px;border-radius:6px;font-size:.72rem;font-weight:600;font-style:normal;padding:0 .4rem;display:flex;align-items:center;overflow:hidden;white-space:nowrap}
.v1 .clip{background:var(--violet);color:var(--on-violet)}
.v2 .clip{background:var(--pink);color:#17123A}
.t1 .clip{border:2px solid var(--ink)}
.a1 .clip{background:var(--lemon);color:#17123A}
.a2 .clip{background:var(--line)}
.head{position:absolute;top:-4px;bottom:-4px;left:calc(2.6rem + (100% - 2.6rem) * .38);width:0;pointer-events:none;animation:scrub 5s cubic-bezier(.6,.05,.25,1) 1 both}
.head::before{content:"";position:absolute;top:0;bottom:0;left:-1px;width:2px;background:var(--ink)}
.head::after{content:"";position:absolute;top:-2px;left:-6px;width:12px;height:12px;background:var(--ink);border-radius:2px 2px 6px 6px}
@keyframes scrub{from{left:2.6rem}to{left:calc(2.6rem + (100% - 2.6rem) * .38)}}

/* Janela de código */
.code{margin-top:4.5rem;background:#0F0B26;border:1px solid var(--line);border-radius:14px;overflow:hidden;color:#F1EFFF}
.code-bar{display:flex;gap:.4rem;align-items:center;padding:.7rem 1rem;background:rgba(255,255,255,.07);font-family:var(--mono);font-size:.8rem;color:#A9A4D0}
.code-bar i{width:11px;height:11px;border-radius:50%;background:#FF6B9C}
.code-bar i:nth-child(2){background:#FFE45C}.code-bar i:nth-child(3){background:#8A74FF}
.code-bar span{margin-left:.6rem}
.code pre{margin:0;padding:1.1rem 1.25rem 1.3rem;font-family:var(--mono);font-size:.92rem;line-height:1.75;overflow-x:auto}
.k{color:#FF6B9C}.s{color:#FFE45C}.n{color:#8A74FF}
.cursor{display:inline-block;width:.55ch;height:1.1em;vertical-align:text-bottom;background:#FFE45C;animation:blink 1.1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}

/* Listas */
.rows{border-top:1px solid var(--line)}
.row{display:grid;gap:.5rem 2.5rem;padding:2.1rem 0;border-bottom:1px solid var(--line)}
.row h3{font-size:1.5rem;font-weight:800}
.row p{color:var(--muted);margin:0}
.tags{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.7rem}
.tag{font-size:.82rem;font-weight:600;padding:.2rem .7rem;border-radius:999px;border:1px solid var(--line);background:var(--surface)}
@media(min-width:720px){.row{grid-template-columns:1fr 1.5fr;align-items:baseline}}

/* Logos */
.group-title{font-size:1.1rem;font-weight:800;margin:0 0 .8rem;color:var(--muted)}
.logos{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:1.1rem;margin-bottom:3rem}
.logo{display:flex;flex-direction:column;align-items:center;gap:.6rem;padding:1.1rem .5rem;background:var(--surface);border:1px solid var(--line);border-radius:14px;font-weight:600;text-align:center}
.logo img,.bd{width:48px;height:48px}
.bd{display:grid;place-items:center;border-radius:11px;font-family:var(--display);font-weight:800;font-size:1.3rem;letter-spacing:-.04em}
.cc{background:#111;color:#fff;border:2px solid #fff}
.pr{background:#00005B;color:#99F;border:1px solid #99F}
.ae{background:#00005B;color:#D291FF;border:1px solid #D291FF}
.ps{background:#001E36;color:#31A8FF;border:1px solid #31A8FF}
.ai{background:#300;color:#FF9A00;border:1px solid #FF9A00}
.dv{background:#1d1d1d;color:#fff;border:2px solid #E9453D}
.cv{background:linear-gradient(135deg,#00C4CC,#7D2AE8);color:#fff}

/* Processo e formação */
.steps{list-style:none;margin:0;padding:0;display:grid;gap:1.4rem;counter-reset:s}
.steps li{counter-increment:s;padding:1.6rem 1.5rem;background:var(--surface);border-left:6px solid var(--violet);border-radius:0 12px 12px 0}
.steps li::before{content:counter(s);font-family:var(--display);font-weight:800;font-size:1.6rem;color:var(--pink);margin-right:.75rem}
.steps strong{font-family:var(--display);font-size:1.25rem;letter-spacing:-.02em}
.steps span{display:block;color:var(--muted)}
@media(min-width:720px){.steps{grid-template-columns:repeat(4,1fr)}.steps.two{grid-template-columns:repeat(2,1fr)}.steps li{border-left:0;border-top:6px solid var(--violet);border-radius:0 0 12px 12px}.steps li::before{display:block;margin:0 0 .4rem}}

/* Ponte entre as duas partes */
.bridge{text-align:center;padding:7rem 1.5rem}
.bridge p{margin:0 auto 1.5rem;color:var(--muted)}
.bridge h2{margin-bottom:1rem}
.btn.big{background:var(--ink);color:var(--bg);border-color:var(--ink);min-height:60px;padding:1rem 2rem;font-size:1.15rem}

/* Contacto */
.contact{background:var(--ink);color:var(--bg);border-radius:28px;padding:4rem 2rem}
.contact h2{margin-bottom:1rem;font-size:clamp(2.2rem,8vw,4.5rem)}
.contact p{opacity:.85}
.contact .btn{border-color:var(--bg);color:var(--bg)}
.contact .btn.main{background:var(--lemon);border-color:var(--lemon);color:#17123A}
.mail{display:block;margin-top:1.25rem;font-weight:600;word-break:break-all}
.toplink{display:inline-block;margin:1.5rem 0 0;font-weight:600}
footer{padding:2rem 0;color:var(--muted);font-size:.9rem}
.bubbles{position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:5}
.bubbles i{position:absolute;left:var(--x);bottom:-140px;width:var(--s);height:var(--s);border-radius:50%;background:radial-gradient(circle at 30% 30%,rgba(255,255,255,.85),var(--c) 70%);opacity:.22;animation:rise var(--d) linear infinite;animation-delay:var(--dl);will-change:transform}
@keyframes rise{to{transform:translate(var(--dx),-120vh)}}
@media(prefers-reduced-motion:reduce){.bubbles{display:none}.head,.cursor{animation:none}.btn{transition:none}html{scroll-behavior:auto}}
</style>
</head>
